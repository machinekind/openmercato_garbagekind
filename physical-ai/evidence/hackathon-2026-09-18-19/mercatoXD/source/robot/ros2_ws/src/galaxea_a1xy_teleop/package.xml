<?xml version="1.0"?>
<package format="3">
  <name>galaxea_a1xy_teleop</name>
  <version>0.1.0</version>
  <description>Arm-to-arm teleoperation for two Galaxea A1X arms: a leader read
  over SocketCAN on can1, a follower commanded through the vendor HDAS on can0.</description>
  <maintainer email="prog74194@gmail.com">v1</maintainer>
  <license>Proprietary</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <!-- hdas_msg ships with the vendor ATC host SDK rather than the workspace;
       it is sourced from a1xy/atc_host_install/setup.bash at runtime. -->
  <exec_depend>hdas_msg</exec_depend>
  <exec_depend>galaxea_a1xy_driver</exec_depend>

  <export><build_type>ament_python</build_type></export>
</package>
