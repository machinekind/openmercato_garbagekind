# syntax=docker/dockerfile:1
# ROS 1 Noetic / Ubuntu 20.04, x86_64 -- required by the Galaxea A1XY SDK.
# The A1XY SDK (A1_XY.tar.gz) is x86-only and ROS Noetic only; the Humble
# container in this repo cannot run it.
ARG BASE_IMAGE=osrf/ros:noetic-desktop-full
FROM ${BASE_IMAGE}

ARG USERNAME=ros
ARG USER_UID=1000
ARG USER_GID=1000

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
        bash-completion build-essential can-utils ccache cmake curl gdb git \
        iproute2 iputils-ping less lsb-release libnlopt0 nano net-tools \
        python3-catkin-tools python3-pip python3-rosdep python3-vcstool \
        tmux udev usbutils vim wget \
        ros-noetic-joint-state-publisher-gui ros-noetic-rqt-common-plugins \
        ros-noetic-tf2-tools ros-noetic-xacro \
    && rm -rf /var/lib/apt/lists/*

# Non-root user matching the host UID/GID so files stay owned by you.
RUN if getent group ${USER_GID} >/dev/null; then \
        groupmod -n ${USERNAME} "$(getent group ${USER_GID} | cut -d: -f1)"; \
    else groupadd --gid ${USER_GID} ${USERNAME}; fi \
 && if getent passwd ${USER_UID} >/dev/null; then \
        usermod -l ${USERNAME} -d /home/${USERNAME} -m "$(getent passwd ${USER_UID} | cut -d: -f1)"; \
    else useradd --uid ${USER_UID} --gid ${USER_GID} -m -s /bin/bash ${USERNAME}; fi \
 && apt-get update && apt-get install -y --no-install-recommends sudo \
 && rm -rf /var/lib/apt/lists/* \
 && echo "${USERNAME} ALL=(root) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME} \
 && chmod 0440 /etc/sudoers.d/${USERNAME} \
 && for g in dialout video plugdev audio render; do \
        getent group "$g" >/dev/null && usermod -aG "$g" ${USERNAME} || true; \
    done

# Same three-hook environment as the Humble image: profile.d covers `bash -lc`,
# .bashrc covers interactive shells, entrypoint covers `docker run`.
RUN install -d -m 0700 -o ${USER_UID} -g ${USER_GID} /tmp/runtime-ros \
 && { \
      echo '# ROS Noetic environment (generated at image build time)'; \
      echo 'source /opt/ros/noetic/setup.bash'; \
      echo 'if [ -f "$HOME/a1xy/A1_XY/install/setup.bash" ]; then source "$HOME/a1xy/A1_XY/install/setup.bash"; fi'; \
      echo 'export PATH=/usr/lib/ccache:$PATH'; \
      echo "alias sws='source ~/a1xy/A1_XY/install/setup.bash'"; \
      echo "alias canup='sudo ip link set can0 down 2>/dev/null; sudo ip link set dev can0 type can bitrate 1000000 dbitrate 5000000 fd on && sudo ip link set up can0 && ip -br link show can0'"; \
    } > /etc/ros1_env.sh \
 && chmod 0644 /etc/ros1_env.sh \
 && echo '. /etc/ros1_env.sh' > /etc/profile.d/10-ros1.sh \
 && chmod 0644 /etc/profile.d/10-ros1.sh \
 && echo '. /etc/ros1_env.sh' >> /home/${USERNAME}/.bashrc \
 && mkdir -p /home/${USERNAME}/a1xy \
 && chown -R ${USER_UID}:${USER_GID} /home/${USERNAME}

COPY docker/entrypoint-noetic.sh /usr/local/bin/entrypoint-noetic.sh
RUN chmod +x /usr/local/bin/entrypoint-noetic.sh

USER ${USERNAME}
WORKDIR /home/${USERNAME}/a1xy
ENV SHELL=/bin/bash
ENTRYPOINT ["/usr/local/bin/entrypoint-noetic.sh"]
CMD ["bash"]
