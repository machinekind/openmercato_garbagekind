# Jedno źródło prawdy o formatowaniu — edytor ma nie być powodem szumu w diffie.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.py]
indent_size = 4

[*.{md,markdown}]
# Dwie spacje na końcu wiersza to w Markdownie twardy podział — nie wolno ich uciąć.
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_size = 2

[Makefile]
indent_style = tab

# Materiał archiwalny zachowuje postać źródła bajt w bajt — patrz NOTICE.
[physical-ai/evidence/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

# Zasoby obce (TensorFlow.js, three.js) zostają w postaci dostarczonej.
[mercato/modules/digital_twins/assets/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
